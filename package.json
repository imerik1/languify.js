{
  "name": "languify.js",
  "version": "1.0.10",
  "description": "Extensible language-inspired utilities for JavaScript and TypeScript.",
  "type": "module",
  "keywords": [
    "oop",
    "functional-programming",
    "pattern-matching",
    "language-inspired",
    "option",
    "result",
    "rust",
    "java",
    "optional",
    "null-safety",
    "golang",
    "python",
    "kotlin",
    "typescript",
    "javascript",
    "fp",
    "match",
    "languify"
  ],
  "homepage": "https://languifyjs.erikmarques.com.br/v1/docs/",
  "bugs": {
    "url": "https://github.com/imerik1/languify.js/issues"
  },
  "author": "imerik1",
  "license": "MIT",
  "private": false,
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imerik1/languify.js.git"
  },
  "exports": {
    "./go": {
      "types": "./dist/lib/go.d.ts",
      "import": "./dist/lib/go.mjs",
      "require": "./dist/lib/go.cjs"
    },
    "./rust": {
      "types": "./dist/lib/rust.d.ts",
      "import": "./dist/lib/rust.mjs",
      "require": "./dist/lib/rust.cjs"
    },
    "./java": {
      "types": "./dist/lib/java.d.ts",
      "import": "./dist/lib/java.mjs",
      "require": "./dist/lib/java.cjs"
    }
  },
  "files": [
    "dist/lib"
  ],
  "scripts": {
    "purge": "rimraf dist",
    "format": "biome format --write",
    "format:ci": "biome ci",
    "lib:build": "cross-env NODE_ENV=production tsup",
    "test": "cross-env NODE_ENV=development vitest",
    "test:watch": "cross-env NODE_ENV=development vitest --watch",
    "tag:validate": "node ./ci/scripts/tag-validate-exists.js",
    "tag:push": "node ./ci/scripts/tag-push.js",
    "rclone:config": "node ./ci/scripts/rclone-config.js && rclone config file",
    "r2:copy": "rclone copy",
    "docs:dev": "cross-env NODE_ENV=development vitepress dev src",
    "pretest:coverage": "rimraf dist/site/v*/coverage",
    "test:coverage": "cross-env NODE_ENV=development vitest --coverage",
    "predocs:build": "rimraf dist/site/v*/docs",
    "docs:build": "cross-env NODE_ENV=production vitepress build src && rsync -a ci/site/* dist/site",
    "site:publish": "rclone copy ./dist/site r2:languifyjs/site",
    "presite:download": "rimraf ./dist/site",
    "site:download": "rclone copy r2:languifyjs/site ./dist/site",
    "site:preview": "wrangler dev",
    "site:deploy": "wrangler deploy",
    "wrangler:login": "wrangler login --browser=false"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^25.9.4",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.3",
    "rsync": "^0.6.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-tabs": "^0.9.0",
    "vitest": "^4.1.9",
    "vue": "^3.5.39",
    "wrangler": "^4.107.0"
  },
  "packageManager": "pnpm@11.9.0",
  "publishConfig": {
    "access": "public"
  }
}
