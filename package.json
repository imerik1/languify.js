{
  "name": "languify.js",
  "version": "1.0.0",
  "description": "Languify.JS is a library for using tools from other programming languages in javascript",
  "type": "module",
  "keywords": [],
  "author": "imerik1",
  "license": "MIT",
  "sideEffects": false,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.2",
      "onFail": "download"
    }
  },
  "repository": {
    "url": "https://github.com/imerik1/languify.js",
    "type": "git"
  },
  "exports": {
    "./rust": {
      "types": "./dist/lib/rust/rust.d.ts",
      "import": "./dist/lib/rust/rust.mjs",
      "require": "./dist/lib/rust/rust.cjs"
    }
  },
  "files": [
    "dist/lib"
  ],
  "scripts": {
    "lib:build": "tsup",
    "lib:test": "vitest",
    "lib:test:watch": "vitest --watch",
    "lib:test:coverage": "vitest --coverage",
    "docs:dev": "vitepress dev src",
    "docs:build": "vitepress build src",
    "docs:serve": "serve dist/docs"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@vitest/coverage-v8": "^4.1.6",
    "serve": "^14.2.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vitepress": "^1.6.4",
    "vitepress-plugin-tabs": "^0.9.0",
    "vitest": "^4.1.6",
    "vue": "^3.5.34"
  }
}
